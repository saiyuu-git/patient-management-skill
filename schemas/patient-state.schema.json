{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patient-state.schema.json",
  "title": "Patient State v0.6",
  "description": "Single source of truth for one patient. Written by code only. facts/labs/investigations hold only user_provided or system_computed items; model reasoning lives only in analyses, diagnoses(model_inferred) and tasks(ai_suggestion). External medical evidence is never stored here; evidence_requests only reference it by ext_* id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patient_id",
    "header",
    "sources",
    "facts",
    "labs",
    "investigations",
    "diagnoses",
    "tasks",
    "analyses",
    "conflicts",
    "evidence_requests"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "patient_id": {
      "$ref": "common.schema.json#/$defs/patient_id"
    },
    "header": {
      "$ref": "#/$defs/header"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "labs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "results",
        "series"
      ],
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lab_result"
          }
        },
        "series": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lab_series"
          }
        }
      }
    },
    "investigations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/investigation"
      }
    },
    "diagnoses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnosis"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "analyses": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "patient_summary": {
          "$ref": "#/$defs/analysis_record"
        },
        "diagnosis_candidates": {
          "$ref": "#/$defs/analysis_record"
        },
        "lab_interpretation": {
          "$ref": "#/$defs/analysis_record"
        },
        "investigation_analysis": {
          "$ref": "#/$defs/analysis_record"
        },
        "problem_list": {
          "$ref": "#/$defs/analysis_record"
        },
        "clinical_assessment": {
          "$ref": "#/$defs/analysis_record"
        },
        "task_suggestions": {
          "$ref": "#/$defs/analysis_record"
        },
        "handover_summary": {
          "$ref": "#/$defs/analysis_record"
        },
        "today_focus": {
          "$ref": "#/$defs/analysis_record"
        },
        "knowledge_supplement": {
          "$ref": "#/$defs/analysis_record"
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "evidence_requests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_request"
      }
    }
  },
  "$defs": {
    "header": {
      "description": "Display label rule (code): display_name ?? alias ?? patient_id. User-provided names are never re-anonymized by the system.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sex",
        "admission_date",
        "last_updated_at",
        "persist_status"
      ],
      "properties": {
        "display_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40,
          "description": "User-provided name, verbatim"
        },
        "alias": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20,
          "description": "User-provided anonymous label"
        },
        "bed": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20
        },
        "sex": {
          "type": "string",
          "enum": [
            "male",
            "female",
            "unknown"
          ]
        },
        "age": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "type": "string",
              "enum": [
                "year",
                "month",
                "day"
              ]
            }
          }
        },
        "admission_date": {
          "description": "Only from an admission record or an explicit user statement; else null. Never inferred.",
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "admission_date_source": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "admission_record",
            "user_stated",
            null
          ]
        },
        "admission_date_fact_id": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/fact_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_updated_at": {
          "$ref": "common.schema.json#/$defs/datetime"
        },
        "persist_status": {
          "description": "Local state persistence only; no cloud sync implied. UI: saved=已更新, updating=更新中, error=更新失败.",
          "type": "string",
          "enum": [
            "saved",
            "updating",
            "error"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "admission_date": {
                "type": "string"
              }
            },
            "required": [
              "admission_date"
            ]
          },
          "then": {
            "required": [
              "admission_date_source"
            ],
            "properties": {
              "admission_date_source": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "source": {
      "description": "Provenance registry. Raw text lives in private storage, not in state, not shown by default.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "kind",
        "received_at"
      ],
      "properties": {
        "source_id": {
          "$ref": "common.schema.json#/$defs/source_id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "admission_record",
            "progress_note",
            "ward_round_note",
            "lab_report",
            "investigation_report",
            "medical_order",
            "discharge_summary",
            "user_message",
            "other"
          ]
        },
        "document_date": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "received_at": {
          "$ref": "common.schema.json#/$defs/datetime"
        },
        "storage_ref": {
          "type": "string",
          "description": "Private raw-text location; never exported"
        },
        "text_origin": {
          "description": "How the raw text was obtained. host_transcription/ocr may contain recognition errors. No OCR is done by this project.",
          "type": "string",
          "enum": [
            "native_text",
            "host_transcription",
            "ocr",
            "manual"
          ]
        }
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "extracted_by"
      ],
      "properties": {
        "source_id": {
          "$ref": "common.schema.json#/$defs/source_id"
        },
        "extracted_by": {
          "$ref": "common.schema.json#/$defs/extracted_by"
        },
        "quote": {
          "type": "string",
          "maxLength": 400,
          "description": "Verbatim snippet; code-verified as substring of source"
        },
        "span": {
          "description": "Location of quote in the raw source (char offsets, end exclusive) and its chunk.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "chunk_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^c[0-9]{2,}$"
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "text",
        "assertion",
        "origin"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/fact_id"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/fact_kind"
            },
            {
              "type": "string",
              "enum": [
                "demographic",
                "plan"
              ]
            }
          ]
        },
        "label": {
          "$ref": "common.schema.json#/$defs/short_text"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/datetime"
            },
            {
              "type": "null"
            }
          ]
        },
        "time_precision": {
          "$ref": "common.schema.json#/$defs/time_precision"
        },
        "origin": {
          "type": "string",
          "enum": [
            "user_provided",
            "system_computed"
          ]
        },
        "source_ref": {
          "$ref": "#/$defs/source_ref"
        },
        "superseded_by": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/fact_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "assertion": {
          "$ref": "common.schema.json#/$defs/assertion"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "user_provided"
              }
            }
          },
          "then": {
            "required": [
              "source_ref"
            ]
          }
        }
      ]
    },
    "lab_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "test_id",
        "test_name",
        "collected_at",
        "raw_value",
        "raw_unit",
        "normalized_value",
        "normalized_unit",
        "reference_low",
        "reference_high",
        "abnormal_flag",
        "value_type",
        "origin",
        "source_ref"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/fact_id"
        },
        "test_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "description": "Internal canonical code (code-mapped); unmapped_<hash> if unknown"
        },
        "test_name": {
          "type": "string",
          "description": "Name as written in source; used for display"
        },
        "specimen": {
          "type": [
            "string",
            "null"
          ]
        },
        "collected_at": {
          "$ref": "common.schema.json#/$defs/datetime"
        },
        "time_precision": {
          "$ref": "common.schema.json#/$defs/time_precision"
        },
        "raw_value": {
          "type": "string",
          "description": "Verbatim, e.g. '<0.01', '阳性(+)'"
        },
        "raw_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "normalized_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "normalized_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference_low": {
          "type": [
            "number",
            "null"
          ]
        },
        "reference_high": {
          "type": [
            "number",
            "null"
          ]
        },
        "reference_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "abnormal_flag": {
          "$ref": "common.schema.json#/$defs/abnormal_flag"
        },
        "abnormal_flag_source": {
          "type": "string",
          "enum": [
            "report",
            "computed",
            "unknown"
          ]
        },
        "value_type": {
          "type": "string",
          "enum": [
            "numeric",
            "qualitative"
          ]
        },
        "origin": {
          "const": "user_provided"
        },
        "source_ref": {
          "$ref": "#/$defs/source_ref"
        }
      }
    },
    "lab_series": {
      "description": "Code-computed objective metrics. Contains NO clinical-significance judgment (that is model reasoning over patient context + external evidence). Citable as fact_series_<test_id>.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "test_id",
        "test_name",
        "unit",
        "point_ids",
        "n_points",
        "data_status",
        "origin",
        "computed_at"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/fact_id"
        },
        "test_id": {
          "type": "string"
        },
        "test_name": {
          "type": "string"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "point_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/fact_id"
          }
        },
        "n_points": {
          "type": "integer",
          "minimum": 0
        },
        "data_status": {
          "$ref": "common.schema.json#/$defs/data_status"
        },
        "first_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "previous_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "latest_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "min_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "first_to_latest": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/change"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_to_latest": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/change"
            },
            {
              "type": "null"
            }
          ]
        },
        "overall_direction": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/direction"
            },
            {
              "type": "null"
            }
          ],
          "description": "= first_to_latest.direction"
        },
        "recent_direction": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/direction"
            },
            {
              "type": "null"
            }
          ],
          "description": "= previous_to_latest.direction"
        },
        "pattern": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/series_pattern"
            },
            {
              "type": "null"
            }
          ]
        },
        "reversal_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reference_status_transition": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "first",
            "previous",
            "latest"
          ],
          "properties": {
            "first": {
              "$ref": "common.schema.json#/$defs/abnormal_flag"
            },
            "previous": {
              "$ref": "common.schema.json#/$defs/abnormal_flag"
            },
            "latest": {
              "$ref": "common.schema.json#/$defs/abnormal_flag"
            }
          }
        },
        "priority_rank": {
          "type": "integer",
          "minimum": 1,
          "description": "Code-computed display order"
        },
        "origin": {
          "const": "system_computed"
        },
        "computed_at": {
          "$ref": "common.schema.json#/$defs/datetime"
        },
        "excluded_point_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/fact_id"
          },
          "description": "Points excluded from metrics because of an unresolved or rejected value conflict"
        },
        "latest_abnormal_flag": {
          "$ref": "common.schema.json#/$defs/abnormal_flag",
          "description": "Flag of the latest point used for ranking/display"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "data_status": {
                "const": "sufficient"
              }
            }
          },
          "then": {
            "required": [
              "first_to_latest",
              "previous_to_latest",
              "overall_direction",
              "recent_direction",
              "pattern",
              "reversal_count"
            ]
          }
        }
      ]
    },
    "investigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "name",
        "performed_at",
        "findings",
        "origin",
        "source_ref"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/fact_id"
        },
        "category": {
          "type": "string",
          "enum": [
            "imaging",
            "ultrasound",
            "ecg",
            "endoscopy",
            "pathology",
            "function_test",
            "microbiology",
            "other"
          ]
        },
        "name": {
          "type": "string"
        },
        "body_site": {
          "type": [
            "string",
            "null"
          ]
        },
        "performed_at": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/datetime"
            },
            {
              "type": "null"
            }
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/fact_id"
              },
              "text": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        },
        "impression": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 600,
          "description": "Report conclusion, verbatim"
        },
        "origin": {
          "const": "user_provided"
        },
        "source_ref": {
          "$ref": "#/$defs/source_ref"
        }
      }
    },
    "diagnosis": {
      "description": "Two tracks. user_provided: verbatim, locked, never rewritten. model_inferred: candidate in a separate pending-review area; never auto-promoted. Promotion = user action creating a new user_provided record (extracted_by=manual, from_candidate_id set).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_text",
        "origin",
        "locked",
        "status",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/dx_id"
        },
        "display_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "origin": {
          "type": "string",
          "enum": [
            "user_provided",
            "model_inferred"
          ]
        },
        "locked": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "resolved",
            "candidate"
          ]
        },
        "review_status": {
          "type": "string",
          "enum": [
            "pending",
            "dismissed",
            "accepted"
          ],
          "description": "model_inferred only"
        },
        "certainty": {
          "$ref": "common.schema.json#/$defs/certainty"
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_ids": {
          "$ref": "common.schema.json#/$defs/evidence_ids"
        },
        "source_ref": {
          "$ref": "#/$defs/source_ref"
        },
        "from_candidate_id": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/dx_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "internal_code": {
          "description": "Internal normalization (e.g. ICD). Never displayed; never overrides display_text.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "system": {
              "type": "string"
            },
            "code": {
              "type": "string"
            }
          }
        },
        "updated_at": {
          "$ref": "common.schema.json#/$defs/datetime"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "user_provided"
              }
            }
          },
          "then": {
            "required": [
              "source_ref"
            ],
            "properties": {
              "locked": {
                "const": true
              },
              "status": {
                "enum": [
                  "active",
                  "resolved"
                ]
              }
            },
            "not": {
              "required": [
                "review_status"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "origin": {
                "const": "model_inferred"
              }
            }
          },
          "then": {
            "required": [
              "certainty",
              "review_status",
              "evidence_ids"
            ],
            "properties": {
              "locked": {
                "const": false
              },
              "status": {
                "const": "candidate"
              },
              "evidence_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "origin",
        "status",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/task_id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "detail": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "origin": {
          "type": "string",
          "enum": [
            "explicit",
            "ai_suggestion"
          ]
        },
        "explicit_source": {
          "type": "string",
          "enum": [
            "user_plan",
            "medical_order",
            "progress_note_plan",
            "ward_round_plan",
            "user_accepted_suggestion"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "in_progress",
            "completed",
            "cancelled"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "high",
            "normal",
            "low"
          ]
        },
        "due_date": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ids": {
          "$ref": "common.schema.json#/$defs/evidence_ids"
        },
        "source_ref": {
          "$ref": "#/$defs/source_ref"
        },
        "from_suggestion_id": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/task_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "dismissed": {
          "type": "boolean",
          "description": "ai_suggestion only"
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/datetime"
        },
        "updated_at": {
          "$ref": "common.schema.json#/$defs/datetime"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "explicit"
              }
            }
          },
          "then": {
            "required": [
              "explicit_source"
            ]
          },
          "else": {
            "not": {
              "required": [
                "explicit_source"
              ]
            }
          }
        }
      ]
    },
    "analysis_record": {
      "description": "Latest result of one model module. output conforms to model-outputs.schema.json#/$defs/<module>.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "attempts"
      ],
      "properties": {
        "status": {
          "$ref": "common.schema.json#/$defs/analysis_status"
        },
        "output": {
          "type": [
            "object",
            "null"
          ]
        },
        "dropped_items": {
          "type": "integer",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "validator_errors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 50
        },
        "external_refs": {
          "$ref": "common.schema.json#/$defs/external_refs"
        },
        "model_label": {
          "type": [
            "string",
            "null"
          ],
          "description": "Logging only; never used for branching"
        },
        "input_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "generated_at": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/datetime"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "conflict": {
      "description": "Deterministically detected contradiction. Never auto-resolved by picking a side; resolution is an explicit user action.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflict_id",
        "kind",
        "subject",
        "status",
        "candidates",
        "detected_at"
      ],
      "properties": {
        "conflict_id": {
          "$ref": "common.schema.json#/$defs/conflict_id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "lab_value_mismatch",
            "locked_diagnosis_change",
            "field_value_mismatch"
          ]
        },
        "subject": {
          "type": "string",
          "maxLength": 120,
          "description": "e.g. lab:cr@2026-10-03T06:00, header.sex, dx_001"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved"
          ]
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "source_id"
            ],
            "properties": {
              "value": {
                "type": "string",
                "maxLength": 200
              },
              "source_id": {
                "$ref": "common.schema.json#/$defs/source_id"
              },
              "ref_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Item ID (fact_*/dx_*) when the value is stored"
              },
              "quote": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 400
              }
            }
          }
        },
        "detected_at": {
          "$ref": "common.schema.json#/$defs/datetime"
        },
        "resolution": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "chosen_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 200
            },
            "resolved_at": {
              "$ref": "common.schema.json#/$defs/datetime"
            }
          }
        }
      }
    },
    "evidence_request": {
      "description": "A focused external-evidence need for this patient. Evidence content lives in the evidence store (ext_*), not in patient state.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "question_type",
        "clinical_question",
        "topic_key",
        "status",
        "external_evidence_status",
        "evidence_ids",
        "relevant_fact_ids",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^evq_[0-9]{3,}$"
        },
        "question_type": {
          "$ref": "evidence.schema.json#/$defs/question_type"
        },
        "clinical_question": {
          "type": "string",
          "maxLength": 200
        },
        "topic_key": {
          "type": "string",
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "repair_needed",
            "answered",
            "cached",
            "no_results",
            "unavailable",
            "failed",
            "expired"
          ]
        },
        "external_evidence_status": {
          "type": "string",
          "enum": [
            "available",
            "pending",
            "unavailable",
            "none_found"
          ]
        },
        "evidence_ids": {
          "$ref": "common.schema.json#/$defs/external_refs"
        },
        "relevant_fact_ids": {
          "$ref": "common.schema.json#/$defs/evidence_ids"
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/datetime"
        },
        "updated_at": {
          "$ref": "common.schema.json#/$defs/datetime"
        }
      }
    }
  }
}
