{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-supplement.schema.json",
  "title": "Patient-linked clinical knowledge for physicians",
  "type": "object",
  "additionalProperties": false,
  "required": ["knowledge_items"],
  "properties": {
    "knowledge_items": {
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "why_relevant", "knowledge", "clinical_connection", "uncertainty", "evidence_ids", "external_refs"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 60},
          "knowledge": {"type": "string", "minLength": 1, "maxLength": 400},
          "why_relevant": {"type": "string", "minLength": 1, "maxLength": 200},
          "clinical_connection": {"type": "string", "minLength": 1, "maxLength": 300},
          "uncertainty": {"enum": ["low", "moderate", "high"]},
          "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true,
            "items": {"$ref": "common.schema.json#/$defs/evidence_ref"}},
          "external_refs": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
            "items": {"$ref": "common.schema.json#/$defs/ext_id"}}
        }
      }
    }
  },
  "description": "Host-generated clinical insights for physicians, submitted through education.submit and kept separate from patient facts. Require patient-linked, fresh page-verified evidence. Empty knowledge_items is valid. No encyclopedia, doses, orders or dashboard tutorials."
}
